* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
  line-height: 1.6;
}

.header {
  position: sticky;
  top: 0;
  background: #0f172a;
  padding: 15px 5%;
  border-bottom: 1px solid #24324a;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  color: white;
  font-size: 22px;
  font-weight: bold;
  text-decoration: none;
}

.logo span {
  color: #38bdf8;
}

.nav-links {
  display: flex;
  gap: 20px;
  list-style: none;
}

.nav-links a {
  color: #94a3b8;
  text-decoration: none;
}

.nav-links a:hover {
  color: #38bdf8;
}

.menu-btn {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 24px;
  cursor: pointer;
}

.hero {
  min-height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 20px;
}

.greeting {
  color: #38bdf8;
  font-weight: bold;
}

.hero h1 {
  font-size: 48px;
  margin: 10px 0;
}

.hero h2 {
  color: #94a3b8;
  margin-bottom: 25px;
}

.buttons {
  display: flex;
  gap: 15px;
}

.btn {
  padding: 12px 25px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}

.primary {
  background: #38bdf8;
  color: #04121f;
}

.outline {
  border: 2px solid #38bdf8;
  color: #38bdf8;
}

.section {
  padding: 70px 8%;
  text-align: center;
}

.alt {
  background: #131e33;
}

.section-title {
  font-size: 32px;
  margin-bottom: 25px;
}

.section-title::after {
  content: "";
  display: block;
  width: 70px;
  height: 4px;
  margin: 10px auto 0;
  background: #38bdf8;
}

.about-text {
  max-width: 700px;
  margin: auto;
  color: #94a3b8;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}

.skills span {
  background: #1e293b;
  border: 1px solid #2c3d57;
  padding: 10px 18px;
  border-radius: 20px;
}

.projects {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  margin-top: 30px;
}

.project-card {
  background: #1e293b;
  border: 1px solid #2c3d57;
  padding: 25px;
  border-radius: 12px;
}

.tags {
  color: #38bdf8;
  font-size: 14px;
  margin-top: 10px;
}

.contact-form {
  max-width: 500px;
  margin: auto;
  display: grid;
  gap: 15px;
}

input,
textarea {
  padding: 12px;
  border-radius: 8px;
  border: 1px solid #2c3d57;
  background: #0b1424;
  color: white;
}

#formStatus {
  color: #38bdf8;
}

.footer {
  text-align: center;
  padding: 25px;
  border-top: 1px solid #24324a;
}

@media (max-width: 720px) {
  .menu-btn {
    display: block;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 65px;
    left: 0;
    right: 0;
    flex-direction: column;
    background: #101a2d;
    padding: 15px 0;
  }

  .nav-links.active {
    display: flex;
  }

  .hero h1 {
    font-size: 34px;
  }
}
